{
  "name": "super-stadium-racing",
  "version": "0.1.0",
  "description": "A modern 3D top-down off-road racing game built with Babylon.js and Havok Physics",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "node server/index.js",
    "build": "npm run build:raw && npm run build:optimize",
    "build:raw": "vite build",
    "build:optimize": "node scripts/optimizeDistAssets.js",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:terrain": "node scripts/check-terrain.mjs",
    "check:panels": "node scripts/check-panel-bindings.mjs",
    "check:surface": "node scripts/check-surface.mjs",
    "check:walls": "node scripts/check-walls.mjs",
    "check:water": "node scripts/check-water.mjs"
  },
  "dependencies": {
    "@babylonjs/core": "^8.0.0",
    "@babylonjs/havok": "^1.3.0",
    "@babylonjs/loaders": "^8.0.0",
    "@colyseus/core": "^0.16.20",
    "@colyseus/ws-transport": "^0.16.5",
    "@vitejs/plugin-vue": "^6.0.5",
    "bootstrap-icons": "^1.13.1",
    "colyseus.js": "^0.16.22",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "fflate": "^0.8.3",
    "pinia": "^3.0.4",
    "vue": "^3.5.31"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.19",
    "ffmpeg-static": "^5.3.0",
    "postcss": "^8.4.35",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.5",
    "vite": "^6.2.0",
    "vitest": "^3.2.7"
  }
}
